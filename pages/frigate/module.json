{
  "name": "Frigate cameras",
  "description": "Live video or regularly refreshed pictures from one or more Frigate cameras.",
  "data": "frigate",
  "options": [
    {
      "key": "title",
      "label": "Title (optional)",
      "type": "text",
      "default": ""
    },
    {
      "key": "frigate",
      "label": "Frigate address (blank uses the one on the Settings page)",
      "type": "text",
      "default": "",
      "required": false,
      "help": "Frigate's unauthenticated port, reachable from both the Vital Signs server and the Pi, for example http://192.168.1.30:5000",
      "setting": "frigate_url"
    },
    {
      "key": "cameras",
      "label": "Cameras",
      "type": "cameras",
      "default": [],
      "help": "Tick the cameras to show. The label is what appears on screen. To set the order, or if the list cannot be fetched, type them below instead, one per line as: camera_name | Label"
    },
    {
      "key": "layout",
      "label": "Layout",
      "type": "select",
      "default": "grid",
      "choices": [
        {
          "value": "grid",
          "label": "All cameras at once, in a grid"
        },
        {
          "value": "cycle",
          "label": "One camera at a time, in turn"
        }
      ]
    },
    {
      "key": "columns",
      "label": "Columns (grid layout)",
      "type": "select",
      "default": "auto",
      "choices": [
        {
          "value": "auto",
          "label": "Automatic: whatever makes the cameras largest"
        },
        {
          "value": "1",
          "label": "1: stacked"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "key": "dwell",
      "label": "Seconds per camera (one at a time)",
      "type": "number",
      "default": 10,
      "min": 3,
      "max": 3600
    },
    {
      "key": "mode",
      "label": "Picture",
      "type": "select",
      "default": "live",
      "choices": [
        {
          "value": "live",
          "label": "Live video (falls back to pictures if a stream will not play)"
        },
        {
          "value": "snapshots",
          "label": "Pictures, refreshed regularly (lightest on the Pi)"
        }
      ]
    },
    {
      "key": "interval",
      "label": "Seconds between pictures",
      "type": "number",
      "default": 2,
      "min": 1,
      "max": 300
    },
    {
      "key": "fit",
      "label": "Fit",
      "type": "select",
      "default": "cover",
      "choices": [
        {
          "value": "cover",
          "label": "Fill the space (crops the edges)"
        },
        {
          "value": "contain",
          "label": "Show the whole picture"
        }
      ]
    },
    {
      "key": "names",
      "label": "Show camera names",
      "type": "checkbox",
      "default": true
    }
  ]
}
