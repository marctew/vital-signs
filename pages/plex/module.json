{
  "name": "Plex now playing",
  "description": "What is playing on a Plex server right now, for everyone or chosen users.",
  "data": "plex",
  "options": [
    {
      "key": "title",
      "label": "Title (optional)",
      "type": "text",
      "default": "Now playing"
    },
    {
      "key": "server",
      "label": "Plex server address",
      "type": "text",
      "default": "",
      "required": true,
      "private": true,
      "help": "As the Vital Signs server reaches it, for example http://192.168.1.20:32400"
    },
    {
      "key": "token",
      "label": "Plex token",
      "type": "secret",
      "default": "",
      "required": true,
      "help": "Your X-Plex-Token. It stays on the server. Leave blank when editing to keep the stored one."
    },
    {
      "key": "users",
      "label": "Users to show, one per line (blank for everyone)",
      "type": "list",
      "default": []
    },
    {
      "key": "paused",
      "label": "Show paused streams",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "show_user",
      "label": "Show who is watching",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "synopsis",
      "label": "Show the synopsis when there is room",
      "type": "checkbox",
      "default": true
    },
    {
      "key": "idle_mode",
      "label": "When nothing is playing",
      "type": "select",
      "default": "text",
      "choices": [
        {
          "value": "text",
          "label": "Show the text below"
        },
        {
          "value": "recent",
          "label": "Show recently added items"
        }
      ]
    },
    {
      "key": "libraries",
      "label": "Libraries for recently added, one per line (blank for all)",
      "type": "list",
      "default": [],
      "help": "Library names exactly as they appear in Plex, for example Films or TV Shows."
    },
    {
      "key": "recent_title",
      "label": "Title over recently added",
      "type": "text",
      "default": "Recently added"
    },
    {
      "key": "idle",
      "label": "Text when nothing is playing",
      "type": "text",
      "default": "Nothing playing"
    }
  ]
}
